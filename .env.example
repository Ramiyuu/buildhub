# Copie para .env (valores gerais) e .env.local (apenas OPENAI_API_KEY). Nenhum dos dois vai para o git.
# Na Railway, cadastre estas mesmas chaves em Variables.

NODE_ENV=production
# A Railway define PORT sozinha.
# PORT=3000

# Postgres. Na Railway: referencie o plugin com ${{ Postgres.DATABASE_URL }}
DATABASE_URL=postgresql://usuario:senha@host:5432/railway
# DATABASE_SSL=false   # use false para a URL interna (*.railway.internal); o padrao liga SSL na URL publica
# DATABASE_POOL_MAX=10

# Obrigatorio em producao: texto aleatorio longo (>= 32 caracteres). Assina sessoes e anonimiza IPs.
SESSION_SECRET=troque-por-um-texto-aleatorio-bem-longo

# Quantos proxies existem na frente do app (Railway = 1). Se usar Cloudflare na frente, use 2 e TRUST_CLOUDFLARE=true.
TRUST_PROXY=1
TRUST_CLOUDFLARE=false

# Paises liberados (codigos ISO separados por virgula). Todo o resto recebe 403.
ALLOW_COUNTRIES=BR
# Quando o pais do IP nao e identificado: block (padrao) ou allow
GEO_UNKNOWN=block

# Usuario administrador criado no primeiro boot (so se ainda nao existir admin)
ADMIN_EMAIL=admin@buildhub.dev
# Use o HASH gerado por `npm run admin:create` (a senha em texto nunca precisa ir para a Railway)
ADMIN_PASSWORD_HASH=

# Atendimento com IA (so vai em .env.local ou nas Variables da Railway)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none

# Dados ficticios para apresentacao (true insere empresas, projetos, cobrancas, visitas... com a flag is_demo)
SEED_DEMO=false
